[application]
config/name="GodWorld — عالم الآلهة"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.035,0.047,0.067,1)

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.035,0.047,0.067,1)

[input]
zoom_in={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":61), Object(InputEventMouseButton,"button_index":4)]}
zoom_out={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":45), Object(InputEventMouseButton,"button_index":5)]}
